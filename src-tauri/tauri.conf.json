{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "view-anything",
  "version": "0.10.0",
  "identifier": "com.rafaam11.viewanything",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:1420 ws://localhost:1421",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "windows": {
      "nsis": { "installerHooks": "windows/file-associations.nsh" }
    },
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt", "log", "ini", "cfg", "conf", "toml", "xml", "html", "htm", "css", "scss", "c", "h", "cc", "cpp", "cxx", "hpp", "py", "rs", "js", "jsx", "ts", "tsx", "sh", "bash", "ps1", "bat", "cmd", "sql", "java", "cs", "go", "rb", "lua"],
        "name": "com.rafaam11.viewanything.text",
        "description": "Text and Code",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "name": "com.rafaam11.viewanything.pdf",
        "description": "PDF",
        "role": "Viewer"
      },
      {
        "ext": ["csv"],
        "name": "com.rafaam11.viewanything.csv",
        "description": "CSV",
        "role": "Viewer"
      },
      {
        "ext": ["json", "yaml", "yml"],
        "name": "com.rafaam11.viewanything.data",
        "description": "Data",
        "role": "Viewer"
      },
      {
        "ext": ["png", "jpg", "jpeg", "webp", "bmp", "gif", "svg"],
        "name": "com.rafaam11.viewanything.image",
        "description": "Image",
        "role": "Viewer"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "com.rafaam11.viewanything.markdown",
        "description": "Markdown",
        "role": "Viewer"
      },
      {
        "ext": [
          "stl",
          "obj",
          "ply",
          "pcd",
          "las",
          "laz",
          "gltf",
          "glb",
          "step",
          "stp",
          "iges",
          "igs"
        ],
        "name": "com.rafaam11.viewanything.model",
        "description": "3D Model",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NTBDNUE5RjJBM0I4Q0EKUldUS3VLUHlxY1ZRbWE1WVM5enVwbzFIWkNMcTRObFNvQjhsUVpza1hzV1IwSExQVDJqR3N4SFMK",
      "endpoints": ["https://github.com/rafaam11/view-anything/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

